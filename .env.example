DEEPSEEK_API_KEY=
# 可选，默认 https://api.deepseek.com
# DEEPSEEK_API_BASE=https://api.deepseek.com

# 本地试跑 GSC sitemap 提交（勿提交 .env）；CI 用 GitHub Secret GOOGLE_SERVICE_ACCOUNT_JSON
