---
import TipsEntryLine from '@/components/TipsEntryLine.astro';
---

<div class="mobile-nav-bar sticky top-[var(--header-h)] z-30 flex min-w-0 items-center gap-2.5 overflow-x-clip py-2.5 lg:hidden">
  <button
    type="button"
    id="sidebar-open-btn"
    class="btn-primary-soft shrink-0"
    aria-expanded="false"
    aria-controls="article-sidebar-drawer"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h10"></path>
    </svg>
    文章列表
  </button>

  <a
    href="/tips/"
    class="mobile-tips-entry calm-card min-w-0 flex-1 rounded-lg border px-3 py-2 transition"
    style="border-color: var(--color-border); background: var(--color-surface-muted);"
    aria-label="想抽烟了？查看戒烟小技巧"
  >
    <TipsEntryLine rotatorId="mobile-tip-rotate" />
  </a>
</div>

<script>
  function initSidebarDrawer() {
    const openBtn = document.getElementById('sidebar-open-btn');
    const drawer = document.getElementById('article-sidebar-drawer');
    const backdrop = document.getElementById('sidebar-backdrop');
    const closeBtn = document.getElementById('sidebar-close-btn');

    if (!openBtn || !drawer || !backdrop) return;
    if (openBtn.dataset.bound === '1') return;
    openBtn.dataset.bound = '1';

  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    let lockedScrollY = 0;

    const lockBodyScroll = (lock) => {
      if (lock) {
        lockedScrollY = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${lockedScrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';
        document.body.style.overflow = '';
        window.scrollTo(0, lockedScrollY);
      }
    };

    const hideMobileDrawerAfterClose = () => {
      const onEnd = (e) => {
        if (e.propertyName !== 'transform' || drawer.classList.contains('is-open')) return;
        drawer.removeEventListener('transitionend', onEnd);
        if (!isDesktop()) drawer.style.display = 'none';
      };
      drawer.addEventListener('transitionend', onEnd);
    };

    const setOpen = (open) => {
      if (!isDesktop()) {
        if (open) {
          drawer.style.display = 'flex';
          void drawer.offsetHeight;
        }
        lockBodyScroll(open);
      }

      drawer.classList.toggle('is-open', open);
      backdrop.classList.toggle('is-visible', open);
      openBtn.setAttribute('aria-expanded', String(open));
      drawer.setAttribute('aria-hidden', String(!open));
      backdrop.setAttribute('aria-hidden', String(!open));

      if (!isDesktop() && !open) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          drawer.style.display = 'none';
        } else {
          hideMobileDrawerAfterClose();
        }
      }

      if (isDesktop()) {
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'true');
        if ('inert' in drawer) {
          drawer.inert = false;
          backdrop.inert = true;
        }
        return;
      }
      if ('inert' in drawer) {
        drawer.inert = !open;
        backdrop.inert = !open;
      }
    };

    if (!isDesktop()) drawer.style.display = 'none';
    setOpen(false);

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    drawer.querySelectorAll('a[href^="/blog/"]').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 1023px)').matches) setOpen(false);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  initSidebarDrawer();
  document.addEventListener('astro:page-load', initSidebarDrawer);
</script>
