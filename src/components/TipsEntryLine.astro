---
import SidebarTipRotator from '@/components/SidebarTipRotator.astro';

interface Props {
  rotatorId: string;
  class?: string;
}

const { rotatorId, class: className = '' } = Astro.props;
---

<div class:list={['tips-entry-line flex min-w-0 items-baseline gap-1 text-xs', className]}>
  <span class="shrink-0 font-medium text-theme-brand">想抽烟了？</span>
  <SidebarTipRotator elementId={rotatorId} class="min-w-0 flex-1 truncate text-theme-secondary" />
</div>
