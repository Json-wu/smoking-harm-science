---
import { siteName } from '@/lib/site';
import ThemeToggle from '@/components/ThemeToggle.astro';
import HeaderMoodLine from '@/components/HeaderMoodLine.astro';
import HeaderMiniProgramQr from '@/components/HeaderMiniProgramQr.astro';
import HeaderMiniProgramQrInit from '@/components/HeaderMiniProgramQrInit.astro';
---

<header class="header-shell sticky top-0 z-50">
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    style="min-height: var(--header-h); padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));"
  >
    <div class="flex min-w-0 flex-1 items-center overflow-visible">
      <div class="header-brand-cluster flex min-w-0 max-w-full items-center gap-1 overflow-visible sm:gap-1.5">
        <a href="/" class="group flex min-w-0 shrink flex-col gap-0.5">
          <span class="block truncate text-lg font-semibold text-theme-brand transition-colors group-hover:text-[var(--color-brand-hover)]">
            {siteName}
          </span>
          <span class="block truncate text-xs text-theme-muted sm:text-sm">科学资料 · 客观表述</span>
        </a>
        <HeaderMiniProgramQr variant="desktop" class="hidden shrink-0 lg:block" />
      </div>
    </div>
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2 md:gap-3">
      <HeaderMoodLine />
      <HeaderMiniProgramQr variant="mobile" class="shrink-0 lg:hidden" />
      <ThemeToggle />
    </div>
  </div>
  <HeaderMiniProgramQrInit />
</header>
