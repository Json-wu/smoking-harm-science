---
import { siteName } from '@/lib/site';
import ThemeToggle from '@/components/ThemeToggle.astro';
import HeaderMoodLine from '@/components/HeaderMoodLine.astro';
---

<header class="header-shell sticky top-0 z-50">
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    style="min-height: var(--header-h); padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));"
  >
    <a href="/" class="group flex min-w-0 flex-col gap-0.5">
      <span class="truncate text-lg font-semibold text-theme-brand transition-colors group-hover:text-[var(--color-brand-hover)]">
        {siteName}
      </span>
      <span class="text-xs text-theme-muted sm:text-sm">科学资料 · 客观表述</span>
    </a>
    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <HeaderMoodLine />
      <ThemeToggle />
    </div>
  </div>
</header>
