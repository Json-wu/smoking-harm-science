---
import { miniProgram } from '@/lib/site';

interface Props {
  /** 搜一搜框内展示的关键词，默认为小程序名称 */
  keyword?: string;
}

const { keyword = miniProgram.name } = Astro.props;
---

<div class="wx-swidget wx-swidget--adaptive" role="group" aria-label="微信搜一搜打开小程序">
  <div class="wx-swidget__qr-wrap">
    <img
      class="wx-swidget__qr"
      src="/images/miniprogram/code-430.jpg"
      srcset="/images/miniprogram/code-430.jpg 430w, /images/miniprogram/code-860.jpg 860w, /images/miniprogram/code-1280.jpg 1280w"
      sizes="(max-width: 640px) 5.5rem, (max-width: 1024px) 6.5rem, 7rem"
      width="112"
      height="112"
      alt={`「${keyword}」微信小程序码`}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="wx-swidget__panel">
    <div class="wx-swidget__brand">
      <svg class="wx-swidget__soso-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 2l2.2 6.8H21l-5.6 4.1 2.1 6.8L12 15.6 6.5 19.7l2.1-6.8L3 8.8h6.8L12 2z"></path>
      </svg>
      <span class="wx-swidget__brand-text">微信搜一搜</span>
    </div>
    <div class="wx-swidget__search" aria-hidden="true">
      <svg class="wx-swidget__search-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16.5 16.5 21 21"></path>
      </svg>
      <span class="wx-swidget__keyword">{keyword}</span>
      <span class="wx-swidget__cursor">|</span>
    </div>
    <p class="wx-swidget__sr-only">
      在微信中打开搜一搜，输入「{keyword}」即可找到该小程序。{miniProgram.hint}
    </p>
  </div>
</div>
