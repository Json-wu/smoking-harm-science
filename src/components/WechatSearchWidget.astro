---
import WechatSosoMaterial from '@/components/WechatSosoMaterial.astro';

interface Props {
  /** 完整物料或仅搜一搜横条 */
  variant?: 'full' | 'bar';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
---

<div role="group" aria-label="微信搜一搜打开小程序" class={className}>
  <WechatSosoMaterial variant={variant} />
</div>
