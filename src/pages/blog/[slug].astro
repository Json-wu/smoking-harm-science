---
import BlogShell from '@/layouts/BlogShell.astro';
import ArticlePostFooter from '@/components/ArticlePostFooter.astro';
import {
  getAdjacentPosts,
  getAllPosts,
  getPostSlug,
  getRecommendedPosts,
} from '@/lib/posts';
import { getCategorySlugByLabel } from '@/lib/categories';
import { buildArticleJsonLd, buildBreadcrumbJsonLd, mergeJsonLd } from '@/lib/seo';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const slug = getPostSlug(post);
const markdownAlternate = new URL(`/blog/${slug}.md`, Astro.site).href;
const { older, newer } = getAdjacentPosts(slug, posts);
const recommended = getRecommendedPosts(post, posts, 2);
const categorySlug = getCategorySlugByLabel(post.data.category);
const blogPath = `/blog/${slug}/`;
const jsonLd = mergeJsonLd(
  buildArticleJsonLd({
    path: blogPath,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    articleSection: post.data.category,
    keywords: [post.data.category, ...post.data.tags],
  }),
  buildBreadcrumbJsonLd([
    { name: '首页', path: '/' },
    ...(categorySlug
      ? [{ name: post.data.category, path: `/category/${categorySlug}/` }]
      : []),
    { name: post.data.title, path: blogPath },
  ]),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BlogShell
  posts={posts}
  currentSlug={slug}
  title={post.data.title}
  description={post.data.description}
  markdownAlternate={markdownAlternate}
  ogType="article"
  keywords={[post.data.category, ...post.data.tags].join(', ')}
  articlePublished={post.data.pubDate.toISOString()}
  articleSection={post.data.category}
  jsonLd={jsonLd}
>
  <article
    class="mx-auto max-w-3xl px-4 py-6 sm:px-8 sm:py-8 lg:py-10"
    style="padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));"
  >
    <header class="mb-8 border-b border-theme pb-8">
      <div class="flex flex-wrap items-center gap-2 text-sm text-theme-muted">
        <span class="badge-category">{post.data.category}</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      </div>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-theme sm:text-3xl">{post.data.title}</h1>
      <p class="mt-3 text-base leading-relaxed text-theme-secondary sm:text-lg">{post.data.description}</p>
    </header>

    <div class="prose-blog">
      <Content />
    </div>

    <ArticlePostFooter older={older} newer={newer} recommended={recommended} />
  </article>
</BlogShell>
