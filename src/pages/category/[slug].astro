---
import BlogShell from '@/layouts/BlogShell.astro';
import PostListCards from '@/components/PostListCards.astro';
import { categoryCatalog, type CategorySlug, filterPostsByCategory } from '@/lib/categories';
import { getAllPosts, getPostSlug } from '@/lib/posts';
import { buildBreadcrumbJsonLd, buildCategoryCollectionJsonLd, mergeJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const slugs = Object.keys(categoryCatalog) as CategorySlug[];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as CategorySlug;
const category = categoryCatalog[slug];

const posts = await getAllPosts();
const filtered = filterPostsByCategory(posts, category.label);
const jsonLd = mergeJsonLd(
  buildCategoryCollectionJsonLd({
    slug,
    name: category.title,
    description: category.description,
    articlePaths: filtered.map((p) => `/blog/${getPostSlug(p)}/`),
  }),
  buildBreadcrumbJsonLd([
    { name: '首页', path: '/' },
    { name: category.label, path: `/category/${slug}/` },
  ]),
);
const categoryKeywords = [category.label, '戒烟科普', '吸烟危害', '烟草知识'].join(', ');
---

<BlogShell
  posts={posts}
  title={category.title}
  description={category.description}
  canonicalPath={`/category/${slug}/`}
  keywords={categoryKeywords}
  jsonLd={jsonLd}
>
  <article
    class="mx-auto max-w-3xl px-4 py-6 sm:px-8 sm:py-8 lg:py-10"
    style="padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));"
  >
    <header class="mb-8 border-b border-theme pb-8">
      <span class="badge-category">{category.label}</span>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-theme sm:text-3xl">{category.title}</h1>
      <p class="mt-3 text-base leading-relaxed text-theme-secondary">{category.description}</p>
      <p class="mt-2 text-sm text-theme-muted">共 {filtered.length} 篇</p>
    </header>

    <PostListCards posts={filtered} emptyMessage="该分类暂无文章。" />
  </article>
</BlogShell>
