---
import BlogShell from '@/layouts/BlogShell.astro';
import PostListCards from '@/components/PostListCards.astro';
import MiniProgramEntry from '@/components/MiniProgramEntry.astro';
import { siteName, siteDescription, categories } from '@/lib/site';
import { getAllPosts } from '@/lib/posts';
import { buildBreadcrumbJsonLd, buildWebPageJsonLd, mergeJsonLd } from '@/lib/seo';

const posts = await getAllPosts();
const latestPosts = posts.slice(0, 10);
const jsonLd = mergeJsonLd(
  buildWebPageJsonLd({
    path: '/',
    name: siteName,
    description: siteDescription,
  }),
  buildBreadcrumbJsonLd([{ name: '首页', path: '/' }]),
);
const homeKeywords = ['戒烟', '吸烟危害', '烟草科普', '戒烟方法', '二手烟', '尼古丁'].join(', ');
---

<BlogShell
  posts={posts}
  title={siteName}
  description={siteDescription}
  canonicalPath="/"
  footerMinimal={false}
  keywords={homeKeywords}
  jsonLd={jsonLd}
>
  <article
    class="mx-auto max-w-3xl px-4 py-6 sm:px-8 sm:py-8 lg:py-10"
    style="padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));"
  >
    <header class="mb-8 border-b border-theme pb-8">
      <span class="badge-category">科普首页</span>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-theme sm:text-3xl">{siteName}</h1>
      <p class="mt-3 text-base leading-relaxed text-theme-secondary sm:text-lg">{siteDescription}</p>
      <p class="mt-4 text-sm text-theme-muted">
        本站为纯静态科普博客，不提供诊疗。内容分为 {categories.length} 类：吸烟危害、戒烟方法、烟草知识；每篇文章附公开可追溯来源。
      </p>
    </header>

    <section aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="text-lg font-semibold text-theme">最新科普文章</h2>
      <div class="mt-4">
        <PostListCards posts={latestPosts} />
      </div>
    </section>

    <section class="mt-10 border-t border-theme pt-8" aria-labelledby="home-miniprogram-heading">
      <h2 id="home-miniprogram-heading" class="sr-only">微信小程序入口</h2>
      <MiniProgramEntry variant="default" />
    </section>
  </article>
</BlogShell>
