---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="您访问的页面不存在或已移除。" noindex canonical={new URL('/404/', Astro.site).href}>
  <main class="mx-auto max-w-lg px-4 py-20 text-center">
    <h1 class="text-2xl font-semibold text-theme">页面未找到</h1>
    <p class="mt-3 text-theme-muted">链接可能有误，或页面已移动。</p>
    <a href="/" class="btn-primary-soft mt-6 inline-flex">返回首页</a>
  </main>
</BaseLayout>
