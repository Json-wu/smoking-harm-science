---
import BlogShell from '@/layouts/BlogShell.astro';
import MiniProgramEntry from '@/components/MiniProgramEntry.astro';
import { categoryCatalog } from '@/lib/categories';
import { siteName, siteDescription, miniProgram, miniProgramFeatures } from '@/lib/site';
import { getAllPosts } from '@/lib/posts';

import { buildBreadcrumbJsonLd, buildWebPageJsonLd, mergeJsonLd } from '@/lib/seo';

const posts = await getAllPosts();
const pageDescription = `${siteName}的定位、内容来源原则与微信小程序说明。`;
const jsonLd = mergeJsonLd(
  buildWebPageJsonLd({ path: '/about/', name: '关于本站', description: pageDescription }),
  buildBreadcrumbJsonLd([
    { name: '首页', path: '/' },
    { name: '关于本站', path: '/about/' },
  ]),
);
---

<BlogShell
  posts={posts}
  title="关于本站"
  description={pageDescription}
  canonicalPath="/about/"
  footerMinimal={false}
  keywords="关于本站,戒烟科普,内容来源,我要戒烟小程序"
  jsonLd={jsonLd}
>
  <article
    class="prose-blog mx-auto max-w-3xl px-4 py-6 sm:px-8 sm:py-8 lg:py-10"
    style="padding-left: max(1rem, env(safe-area-inset-left)); padding-right: max(1rem, env(safe-area-inset-right));"
  >
    <header class="mb-8 border-b border-theme pb-8">
      <h1 class="text-2xl font-bold tracking-tight text-theme sm:text-3xl">关于本站</h1>
      <p class="mt-3 text-lg text-theme-secondary">{siteDescription}</p>
    </header>

    <h2>我们做什么</h2>
    <p>
      {siteName} 面向中文读者，整理吸烟危害、烟草知识与科学戒烟方法，采用 Astro 生成纯静态页面，不收集账号信息，不嵌入第三方广告追踪脚本。
    </p>

    <h2>内容来源原则</h2>
    <ul>
      <li>优先引用世界卫生组织、各国公共卫生机构、同行评议综述等可追溯来源。</li>
      <li>不编造统计数字；机构数据注明调查年份与口径差异。</li>
      <li>语气客观中性，结论前置，并区分「证据充分」与「尚需更多研究」。</li>
      <li>科普不能替代医生面诊、戒烟门诊或精神科评估。</li>
    </ul>

    <h2>文章分类</h2>
    <p>博客文章按以下三类组织，便于检索与连续阅读：</p>
    <ul class="not-prose my-4 space-y-2 text-base">
      {
        Object.entries(categoryCatalog).map(([slug, cat]) => (
          <li>
            <a href={`/category/${slug}/`} class="text-theme-brand underline decoration-brand/40 underline-offset-2">
              {cat.label}
            </a>
            <span class="text-theme-muted"> — {cat.description}</span>
          </li>
        ))
      }
    </ul>

    <h2>微信小程序「{miniProgram.name}」</h2>
    <p>{miniProgram.hint}</p>
    <p>阅读本站后，若希望用打卡、进度记录或放松类界面辅助日常自律，可在微信搜一搜中打开该小程序。主要功能类型包括：</p>
    <ul>
      {miniProgramFeatures.map((f) => (
        <li>
          <strong>{f.title}</strong>：{f.description}
        </li>
      ))}
    </ul>
    <p>小程序能力与菜单以实际版本为准，不承诺戒烟成功率。</p>

    <div class="not-prose mt-8">
      <MiniProgramEntry variant="default" />
    </div>
  </article>
</BlogShell>
